{
  "name": "batchmyphotos",
  "version": "1.0.1",
  "description": "Desktop utility for photographers to batch-split image folders",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:appx": "npm run build && electron-builder --win appx",
    "pack": "electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.js\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.batchmyphotos.app",
    "productName": "Batch My Photos",
    "publish": [
      {
        "provider": "github",
        "owner": "theo2815",
        "repo": "Batch-My-Photos"
      }
    ],
    "protocols": {
      "name": "BatchMyPhotos",
      "schemes": [
        "batchmyphotos"
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/main/**/*",
      "src/utils/**/*",
      "src/constants/**/*",
      "src/images/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "src/images/app_icon.png"
    },
    "appx": {
      "identityName": "TheoCedricChan.BatchMyPhotos",
      "publisher": "CN=1FE7A803-DE64-49ED-9374-F2C23A3510D5",
      "applicationId": "BatchMyPhotos",
      "displayName": "Batch My Photos",
      "publisherDisplayName": "Theo Cedric Chan",
      "languages": [
        "en-US"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "src/images/app_icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/images/app_icon.png"
    }
  },
  "keywords": [
    "electron",
    "react",
    "photography",
    "batch",
    "utility"
  ],
  "author": "Theo Cedric Chan",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.7.3",
    "exifr": "^7.1.3",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "vite": "^5.0.10",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  }
}
