# BatchMyPhotos Website — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# On Vercel, set these in Project Settings → Environment Variables.

# Supabase (https://supabase.com/dashboard) — the entire data layer.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# /api/version (desktop update banner) — server-side only, not NEXT_PUBLIC.
# Changing these on Vercel requires a redeploy.
LATEST_APP_VERSION=1.0.5
APP_DOWNLOAD_URL=https://github.com/theo2815/Batch-My-Photos/releases/latest
APP_RELEASE_DATE=
MS_STORE_URL=https://apps.microsoft.com/detail/9N1KKMV4NX4J
