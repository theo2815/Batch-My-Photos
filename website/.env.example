# ============================================================================
# BatchMyPhotos — Deployment Environment Reference
# ============================================================================
# The old Railway server held EVERY variable. The new architecture splits them
# across three places. This file is the single reference; each section says
# where to set the values. Never commit real values.
#
# Local website dev: copy the VERCEL section into .env.local and fill it in.

# ── 1. VERCEL (website) — Project Settings → Environment Variables ───────────

# Supabase project (public by design; RLS is the security boundary).
# Was VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY on Railway.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# /api/version — desktop update banner (server-side only, same names as on
# Railway). Changing these on Vercel requires a redeploy to take effect.
LATEST_APP_VERSION=1.0.5
APP_DOWNLOAD_URL=https://github.com/theo2815/Batch-My-Photos/releases/latest
APP_RELEASE_DATE=
MS_STORE_URL=https://apps.microsoft.com/detail/9N1KKMV4NX4J

# ── 2. SUPABASE EDGE FUNCTION SECRETS ────────────────────────────────────────
# Set via:  npx supabase secrets set NAME=value   (or Dashboard → Edge Functions)
# Do NOT set these on Vercel — the website never sees payment/email secrets.
#
#   PAYMONGO_SECRET_KEY      (checkout, verify-payment)
#   PAYMONGO_WEBHOOK_SECRET  (paymongo-webhook HMAC)
#   RESEND_API_KEY           (all transactional email)
#   EMAIL_FROM               (default: BatchMyPhotos <notifications@batchmyphotos.com>)
#   EMAIL_REPLY_TO           (default: batchmyphotos@gmail.com)
#   EMAIL_FN_SECRET          (NEW — shared secret authorizing pg_net -> send-email)
#   FRONTEND_URL             (optional — checkout redirect fallback,
#                             default https://www.batchmyphotos.com)
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically — never set them anywhere yourself.

# ── 3. SUPABASE VAULT (SQL editor, once per project) ─────────────────────────
# Lets the database call the send-email function (migration 20260831000003):
#
#   select vault.create_secret('https://<project-ref>.supabase.co/functions/v1/send-email', 'email_fn_url');
#   select vault.create_secret('<same value as EMAIL_FN_SECRET>', 'email_fn_secret');

# ── 4. RETIRED WITH RAILWAY (do not carry over) ──────────────────────────────
#   PORT                       — Express-only
#   PAYMONGO_PUBLIC_KEY        — was never read by any code
#   ADMIN_EMAILS               — replaced by the admin_users table
#   SUPABASE_SERVICE_ROLE_KEY  — auto-injected in Edge Functions; ROTATE it
#                                after Railway is deleted (it lived there)
