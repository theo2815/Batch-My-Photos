# BatchMyPhotos Backend — Environment Variables
# Copy this file to .env and fill in your actual values.

PORT=3000

# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS — comma-separated list of allowed origins
# For single-deploy (backend serves website), include your own URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PayMongo (https://dashboard.paymongo.com)
# Use sk_test_* keys for development, sk_live_* for production
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# Frontend URL — used for PayMongo success/cancel redirect URLs
# For single-deploy, this is the same as your server URL
FRONTEND_URL=http://localhost:3000

# Resend — Email notifications (https://resend.com)
# Get your API key from the Resend dashboard
RESEND_API_KEY=re_your_resend_api_key
# Sender address — must use a verified domain in Resend
EMAIL_FROM=BatchMyPhotos <notifications@batchmyphotos.com>
